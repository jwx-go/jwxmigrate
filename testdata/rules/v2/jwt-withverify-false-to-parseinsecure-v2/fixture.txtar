-- input/main.go --
package example

import (
	"github.com/lestrrat-go/jwx/v2/jwt"
)

// v2 jwt.ParseString(data, jwt.WithVerify(false)) maps to v4
// jwt.ParseInsecure([]byte(data)). The tool recognizes the
// jwt.WithVerify(false) argument via the existing fixWithVerifyFalse
// rewriter.
//
// PRECISION: the rule fires ONLY when a literal jwt.WithVerify(false)
// argument is present. Bare jwt.Parse / jwt.ParseString calls — which
// already verify signatures — must NOT be flagged. The note text
// suggests ParseInsecure, and an LLM-driven migration consuming
// --format json could otherwise rewrite a signature-verifying call
// into ParseInsecure and silently disable verification. This precondition
// is enforced by ruleArgPredicateOK during AST matching.
//
// KNOWN GAP: deriveSignatureChange extracts only the v2 field
// ("ParseString") as the matcher name, not every search_patterns entry.
// So this rule currently fires only on ParseString calls, missing Parse
// calls (which have the same v2/v4 mapping). The Parse-with-WithVerify(false)
// call below is captured in the golden verbatim (unmodified) to surface
// this gap — it should be regenerated when deriveSignatureChange learns
// to extract multiple names like deriveRemovedOrMoved does.

func insecure(data string) (jwt.Token, error) {
	return jwt.ParseString(data, jwt.WithVerify(false))
}

func insecureBytes(data []byte) (jwt.Token, error) {
	return jwt.Parse(data, jwt.WithVerify(false))
}

// Bare verifying call: must NOT be flagged. Suggesting ParseInsecure
// here would silently strip the signature check.
func verifying(data string) (jwt.Token, error) {
	return jwt.ParseString(data)
}

// Same shape with []byte: also must NOT be flagged.
func verifyingBytes(data []byte) (jwt.Token, error) {
	return jwt.Parse(data)
}
