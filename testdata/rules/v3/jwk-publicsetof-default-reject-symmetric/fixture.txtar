-- want_fix/main.go --
package example

import (
	"github.com/lestrrat-go/jwx/v4/jwk"
)

// Behavioral rule: v4 PublicSetOf default-rejects sets containing
// symmetric (oct) keys. v3 silently included them in the output.
// Existing call sites still compile against v4, but may start
// returning an error at runtime if the input contains an oct key.

func publish(set jwk.Set) (jwk.Set, error) {
	return jwk.PublicSetOf(set)
}

// Explicit opt-in to the v3 pass-through behavior — also flagged so
// the migrator knows it's a deliberate choice rather than a missed
// behavior change.
func publishLegacy(set jwk.Set) (jwk.Set, error) {
	return jwk.PublicSetOf(set, jwk.WithAllowSymmetric(true))
}
