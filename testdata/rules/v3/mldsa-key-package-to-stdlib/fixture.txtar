-- want_fix/main.go --
package consumer

import (
	"crypto/mldsa"

	"github.com/lestrrat-go/jwx/v4/jwk"
)

func key() (jwk.Key, error) {
	priv, err := mldsa.GenerateKey(mldsa.MLDSA44())
	if err != nil {
		return nil, err
	}
	return jwk.Import[jwk.Key](priv)
}
