import (
	"filippo.io/mldsa"

	"github.com/lestrrat-go/jwx/v4/jwa"
)

func params() *mldsa.Parameters {
	var p *mldsa.Parameters = mldsa.MLDSA65()
	_ = jwa.RS256()
	return p
}
