-- input/main.go --
package example

import "github.com/lestrrat-go/jwx/v3/jwk"

func parseSet(data []byte) (jwk.Set, error) {
	return jwk.Parse(data)
}

func parseSetStrict(data []byte) (jwk.Set, error) {
	return jwk.Parse(data, jwk.WithStrictKeySetParsing(true))
}

func parseSetDropInvalid(data []byte) (jwk.Set, error) {
	return jwk.Parse(data, jwk.WithIgnoreParseError(true))
}

func parseSetKeepDefault(data []byte) (jwk.Set, error) {
	return jwk.Parse(data, jwk.WithIgnoreParseError(false))
}
