package example

import (
	"github.com/lestrrat-go/jwx/v3/jwa"
	"github.com/lestrrat-go/jwx/v3/jws"
)

// v4 changed multiple Unregister* functions across jwk, jws, jwe, jwt,
// jwt/openid from void to error-returning. Statement-style use compiles;
// expression-site use breaks.

func cleanup() {
	jws.UnregisterSigner(jwa.RS256())
	jws.UnregisterVerifier(jwa.RS256())
	jws.UnregisterCustomField("ext")
}
